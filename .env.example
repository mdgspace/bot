SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_SIGNING_SECRET=replace-me
REDIS_URL=redis://localhost:6379
BOT_NAME=bot
PORT=8080
TZ=Asia/Kolkata

# Human Slack user IDs allowed to use env/show storage/show users/die.
# Empty disables these commands. Comma-separated; configure outside chat.
BOT_ADMIN_IDS=
# Dedicated directory for approved environment files; empty disables env load.
HUBOT_ENV_BASE_PATH=
# In production containers, REDIS_URL must reference a reachable external Redis,
# not localhost. Keep the existing URL key prefix to preserve memory.

# Existing script configuration remains supported.
INFO_SPREADSHEET_URL=
HUBOT_YOUTUBE_API_KEY=
HUBOT_YOUTUBE_HEAR=true
HUBOT_GOOGLE_CSE_ID=
HUBOT_GOOGLE_CSE_KEY=
HUBOT_ENV_AUTH_TOKEN=
HUBOT_ENV_HIDDEN_WORDS=SECRET,PASSWORD,TOKEN,API_KEY
